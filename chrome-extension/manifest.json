{
  "manifest_version": 3,
  "name": "MVP VRN — AI Caregiver Dashboard",
  "version": "1.1.0",
  "description": "Real-time proactive elderly care dashboard powered by Gemini AI, ADK, MCP and A2A agents. Built for the Agentic AI Builder Series 2026 Finale.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open MVP VRN Dashboard"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "notifications",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
